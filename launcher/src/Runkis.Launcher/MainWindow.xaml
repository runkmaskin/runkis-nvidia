<Window x:Class="Runkis.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Runkis.Launcher"
        Title="Runkis Launcher" Width="1280" Height="820" MinWidth="1000" MinHeight="660"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Ui}" Foreground="{StaticResource Text}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <l:StatusBrush x:Key="StatusBrush"/>
    <l:StatusGlyph x:Key="StatusGlyph"/>
    <l:LineBrush x:Key="LineBrush"/>
    <l:VisibleIf x:Key="Vis"/>
    <l:IsPage x:Key="IsPage"/>
    <l:CellTone x:Key="CellTone"/>

    <!-- A setting row: name and explanation on the left, the control on the right. -->
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <DataTemplate x:Key="TileTemplate">
      <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12" Padding="16,14" ToolTip="{Binding Why}">
        <Grid>
          <Border Width="3" HorizontalAlignment="Left" Margin="-16,-2,0,-2" CornerRadius="2" Background="{Binding Tone}"/>
          <StackPanel>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
            <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Sub}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,18,16,16">
        <StackPanel DockPanel.Dock="Top" Margin="6,0,0,28">
          <TextBlock Text="RUNKIS" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="VIctory launcher · Series S" Style="{StaticResource Label}" Margin="0,2,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" CornerRadius="10" Padding="14,12" BorderBrush="{StaticResource Line}" BorderThickness="1">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="9" Height="9" Fill="{Binding StateTone}" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding State}" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{Binding RunTitle}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding WarmPercent, Mode=OneWay, TargetNullValue=0}"
                         Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"
                         Visibility="{Binding WarmBarVisible, Converter={StaticResource Vis}}"/>
          </StackPanel>
        </Border>
        <!-- Play mode / Dev mode: remembered in launcher.json -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                ToolTip="Play mode shows the game, PLAY and the settings a player needs. Dev mode shows every page and setting: Benchmark, Diagnostics, Logs, System, performance and log settings.">
          <StackPanel>
            <TextBlock Text="{Binding ModeLabel}" FontWeight="SemiBold"/>
            <CheckBox IsChecked="{Binding DevMode}" Content="Developer pages and settings" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <StackPanel>
          <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="Play" Command="{Binding Go}" CommandParameter="Play" IsChecked="{Binding PageIndex, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=0}"/>
          <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="Benchmark" Visibility="{Binding DevMode, Converter={StaticResource Vis}}" Command="{Binding Go}" CommandParameter="Benchmark" IsChecked="{Binding PageIndex, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=5}"/>
          <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="Settings" Command="{Binding Go}" CommandParameter="Settings" IsChecked="{Binding PageIndex, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=1}"/>
          <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="Controls" Command="{Binding Go}" CommandParameter="Controls" IsChecked="{Binding PageIndex, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=6}"/>
          <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="Diagnostics" Visibility="{Binding DevMode, Converter={StaticResource Vis}}" Command="{Binding Go}" CommandParameter="Diagnostics" IsChecked="{Binding PageIndex, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=2}"/>
          <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="Logs" Visibility="{Binding DevMode, Converter={StaticResource Vis}}" Command="{Binding Go}" CommandParameter="Logs" IsChecked="{Binding PageIndex, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=3}"/>
          <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="System" Visibility="{Binding DevMode, Converter={StaticResource Vis}}" Command="{Binding Go}" CommandParameter="System" IsChecked="{Binding PageIndex, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=4}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Title bar buttons -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="5">
      <Button Style="{StaticResource TitleButton}" Content="—" Click="Minimize"/>
      <Button Style="{StaticResource TitleButton}" Content="▢" Click="Maximize"/>
      <Button Style="{StaticResource TitleButton}" Content="✕" Click="CloseWindow"/>
    </StackPanel>

    <!-- Toast -->
    <Border Grid.Column="1" Panel.ZIndex="6" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
            Background="#2A3445" CornerRadius="8" Padding="16,10" MaxWidth="700"
            Visibility="{Binding ToastText, Converter={StaticResource Vis}}">
      <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap"/>
    </Border>

    <TabControl Grid.Column="1" SelectedIndex="{Binding PageIndex, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,40,0,0">
      <TabControl.ItemContainerStyle>
        <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style>
      </TabControl.ItemContainerStyle>
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate>
      </TabControl.Template>

      <!-- ============================== PLAY ============================== -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,8,32,32">
            <Border CornerRadius="14" Padding="28,24" Margin="0,0,0,18" BorderBrush="{StaticResource Line}" BorderThickness="1">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#1B2740" Offset="0"/>
                  <GradientStop Color="#151B24" Offset="0.7"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding GameName}" Style="{StaticResource H1}"/>
                  <TextBlock Text="{Binding GameFolder}" Style="{StaticResource Label}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding ProfileSummary}" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}" Width="280" ToolTip="Profile"/>
                    <Button Content="Choose game…" Command="{Binding BrowseGame}" Margin="10,0,0,0"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                  <Button Style="{StaticResource Primary}" Command="{Binding Launch}" FontSize="18" Padding="56,16"
                          Visibility="{Binding IsRunning, Converter={StaticResource Vis}, ConverterParameter=not}">
                    <TextBlock Text="▶  PLAY" Foreground="White" FontWeight="Bold"/>
                  </Button>
                  <Button Style="{StaticResource Danger}" Command="{Binding Stop}" FontSize="18" Padding="56,16"
                          Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                    <TextBlock Text="■  STOP" Foreground="White" FontWeight="Bold"/>
                  </Button>
                  <Button Command="{Binding WarmUp}" Margin="0,10,0,0" Padding="16,8"
                          Visibility="{Binding IsRunning, Converter={StaticResource Vis}, ConverterParameter=not}"
                          ToolTip="The fast warm-up: translates every shader of the game into the cache, then builds the pipelines earlier plays drew with into the driver's cache, the places played last first. Fewer hitches when you come back to a place. Run it once after a new build, and again after playing new places.">
                    <TextBlock Text="⚡  Warm up (what you've played)"/>
                  </Button>
                  <Button Command="{Binding WarmUpFull}" Margin="0,6,0,0" Padding="12,5" FontSize="12"
                          Visibility="{Binding IsRunning, Converter={StaticResource Vis}, ConverterParameter=not}"
                          ToolTip="The full warm-up: as the fast one, then every pipeline the game has ever created, drawn with or not (fewer hitches in places never visited). Takes an hour or more and needs about 23 GB free on C:.">
                    <TextBlock Text="Full warm-up (everything recorded)"/>
                  </Button>
                  <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Hint}" MaxWidth="260" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Start as: the profile, or a preset over it -->
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Start as" Style="{StaticResource H2}" Margin="0"/>
              <Button Content="Save this preset as a profile…" Command="{Binding SavePreset}" HorizontalAlignment="Right"
                      Visibility="{Binding UsingPreset, Converter={StaticResource Vis}}" Padding="12,5" FontSize="12"/>
            </DockPanel>
            <ListBox ItemsSource="{Binding StartChoices}" SelectedItem="{Binding SelectedStart}" Margin="0,0,-10,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="9" Padding="12,11" Margin="0,0,10,10">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="b" Property="Background" Value="#1C2A45"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Text="{Binding StartDescription}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,10,0,18"/>

            <ItemsControl ItemsSource="{Binding Problems}" Margin="0,0,0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#2A1C1F" BorderBrush="{Binding Severity, Converter={StaticResource StatusBrush}}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}"/>
                      <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding Fix, StringFormat=What to do: {0}}" Style="{StaticResource Hint}" Foreground="{StaticResource Muted}"/>
                      <TextBlock Text="{Binding Evidence}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Columns="4" Margin="0,0,-12,0">
              <ContentControl Content="{Binding Fps}" ContentTemplate="{StaticResource TileTemplate}"/>
              <ContentControl Content="{Binding FrameTime}" ContentTemplate="{StaticResource TileTemplate}"/>
              <ContentControl Content="{Binding Low}" ContentTemplate="{StaticResource TileTemplate}"/>
              <ContentControl Content="{Binding Hitches}" ContentTemplate="{StaticResource TileTemplate}"/>
            </UniformGrid>
            <UniformGrid Columns="4" Margin="0,0,-12,0" Visibility="{Binding DevMode, Converter={StaticResource Vis}}">
              <ContentControl Content="{Binding CpuTile}" ContentTemplate="{StaticResource TileTemplate}"/>
              <ContentControl Content="{Binding Ram}" ContentTemplate="{StaticResource TileTemplate}"/>
              <ContentControl Content="{Binding Gpu}" ContentTemplate="{StaticResource TileTemplate}"/>
              <ContentControl Content="{Binding Vram}" ContentTemplate="{StaticResource TileTemplate}"/>
            </UniformGrid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="Frame times" Style="{StaticResource H2}"/>
                  <TextBlock Text="every presented frame, from the layer's own frame log · red: 100 ms or longer" Style="{StaticResource Hint}" HorizontalAlignment="Right" Margin="0"/>
                </DockPanel>
                <l:FrameGraph Samples="{Binding FrameSamples}" Height="170"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Before you play" Style="{StaticResource H2}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0" Visibility="{Binding DevMode, Converter={StaticResource Vis}}">
                    Translate shaders once per new build, and build the pipeline cache after a session that met new places
                    (needs about 23 GB free on C:). Both cut the hitches of the first visit.
                  </TextBlock>
                  <TextBlock Style="{StaticResource Hint}" Margin="0" Visibility="{Binding DevMode, Converter={StaticResource Vis}, ConverterParameter=not}">
                    Press Warm up once after a new build, and again after playing new places. It cuts the hitches when you
                    come back to a place. The full warm-up also builds what you have not drawn yet (an hour or more, about 23 GB on C:).
                  </TextBlock>
                  <TextBlock Text="{Binding ChecksSummary}" Margin="0,10,0,0" Foreground="{StaticResource Muted}"/>
                  <TextBlock Text="{Binding CheckIssues}" Margin="0,6,0,0" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                             Visibility="{Binding DevMode, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding DevMode, Converter={StaticResource Vis}}">
                  <Button Content="Translate shaders" Command="{Binding Precompile}" Margin="0,0,8,0"/>
                  <Button Content="Build pipeline cache" Command="{Binding Warm}" Margin="0,0,8,0"/>
                  <Button Content="Check setup" Command="{Binding Go}" CommandParameter="Diagnostics"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== SETTINGS ============================== -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,8,32,32" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18">
              The base settings come from scripts\play-nvidia.ps1, the same tuned set PLAY.bat uses. What you set here goes on top,
              and every field is a setting the emulator really reads. Empty fields keep the script's value.
            </TextBlock>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Profile" Style="{StaticResource H2}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding Profile.Name, UpdateSourceTrigger=PropertyChanged}"/>
                  <WrapPanel Grid.Column="1" Margin="10,0,0,0">
                    <Button Style="{StaticResource Primary}" Content="Save" Command="{Binding Save}" Margin="0,0,8,0" Padding="22,7"/>
                    <Button Content="New" Command="{Binding NewProfile}" Margin="0,0,8,0"/>
                    <Button Content="Duplicate" Command="{Binding Duplicate}" Margin="0,0,8,0"/>
                    <Button Content="Import…" Command="{Binding Import}" Margin="0,0,8,0"/>
                    <Button Content="Export…" Command="{Binding Export}" Margin="0,0,8,0"/>
                    <Button Content="Delete" Command="{Binding Delete}"/>
                  </WrapPanel>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="Saving over a profile keeps the old one as .bak; deleting moves it to profiles\deleted."/>
                <TextBlock Text="{Binding ValidationText}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding ValidationText, Converter={StaticResource Vis}}"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Game and folders" Style="{StaticResource H2}"/>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Game executable"/><TextBlock Style="{StaticResource Hint}" Text="Your own copy of game_scarlett_master.exe (v1.0.2.1)."/></StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Profile.GameExe, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseGame}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}" Visibility="{Binding DevMode, Converter={StaticResource Vis}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Cache folder"/><TextBlock Style="{StaticResource Hint}" Text="Translated shaders and pipelines. Empty: %LOCALAPPDATA%\victory\cache. Never inside the source tree."/></StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Profile.CacheDir, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseCache}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}" Visibility="{Binding DevMode, Converter={StaticResource Vis}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Data folder"/><TextBlock Style="{StaticResource Hint}" Text="Saves and crashes.log. Empty: %LOCALAPPDATA%\victory\data."/></StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Profile.DataDir, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseData}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <Grid Visibility="{Binding DevMode, Converter={StaticResource Vis}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Project folder"/><TextBlock Style="{StaticResource Hint}" Text="The runkis-nvidia source tree with target\ and scripts\."/></StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding RepoText}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                  <Button Grid.Column="2" Content="Change…" Command="{Binding BrowseRepo}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Picture and frame rate" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="These are victory play's own options. What the in-game F1 menu saves (%LOCALAPPDATA%\victory\victory-settings.txt) goes over them at every start, as with a double click on victory.exe."/>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Console model"/><TextBlock Style="{StaticResource Hint}" Text="Series X (default): 2560x1440 with DLSS. Series S: 1080p output, faster and softer."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Consoles}" SelectedItem="{Binding Profile.Console}" Width="260" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Series X picture"/><TextBlock Style="{StaticResource Hint}" Text="The output and scene size on Series X (Series S has its own)."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding PictureChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Profile.Picture}" Width="320" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="DLSS"/><TextBlock Style="{StaticResource Hint}" Text="DLSS Super Resolution in place of the game's upscaling; the mode sets the scene's size. Needs NVIDIA's files (victory get-dlss)."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding DlssChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Profile.Dlss}" Width="320" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Frame generation"/><TextBlock Style="{StaticResource Hint}" Text="On from the start; off, it is made ready and F1 in the game switches it. Needs DLSS on; more than 2x needs an RTX 50."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding FrameGenChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Profile.FrameGen}" Width="320" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Frame generation type"/><TextBlock Style="{StaticResource Hint}" Text="Auto: DLSS frame generation where the card has it (RTX 40 and later, with hardware GPU scheduling on), else AMD FSR 3."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding FgTypeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Profile.FgType}" Width="360" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Frame rate cap"/><TextBlock Style="{StaticResource Hint}" Text="Frames a second at most; the game asks for 30."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding FpsChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Profile.Fps}" Width="260" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Full screen"/><TextBlock Style="{StaticResource Hint}" Text="A borderless window covering the monitor (VICTORY_FULLSCREEN)."/></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding Profile.Fullscreen}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Graphics card"/><TextBlock Style="{StaticResource Hint}" Text="Numbered in the order Windows lists them (VICTORY_ADAPTER)."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding AdapterChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Profile.Adapter}" Width="420" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}" Visibility="{Binding DevMode, Converter={StaticResource Vis}}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Build"/><TextBlock Style="{StaticResource Hint}" Text="Release: what victory play is built as. Diag: captures, DRED and debug logs; slower. The one that is built is used."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Builds}" SelectedItem="{Binding Profile.Build}" Width="260" HorizontalAlignment="Left"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="This fork's switches (off by default)" Style="{StaticResource H2}"/>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Water light"/><TextBlock Style="{StaticResource Hint}" Text="VICTORY_WATER_LIGHT: the water's own light pass, a quarter of the card's time in the city. Off measured 16.9 to 19.9 fps and almost no long frames (RTX 4070 SUPER, city at night); the water is darker and bluer."/></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding Profile.WaterLight}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Texture memory diet"/><TextBlock Style="{StaticResource Hint}" Text="VICTORY_TEXTURE_UNMAPPED + VICTORY_TEXTURE_RAM: textures in system memory 6.0 to 2.7 GB in the prison intro at the same fps (RTX 4070 SUPER)."/></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding Profile.TextureDiet}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Game thread priority cap"/><TextBlock Style="{StaticResource Hint}" Text="VICTORY_TITLE_PRIORITY_CAP: the game runs 13 worker threads at the highest priority, which can make the desktop lag while it plays. Not measured in game on this base yet."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding PriorityCapChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Profile.TitlePriorityCap}" Width="320" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Fence sleep"/><TextBlock Style="{StaticResource Hint}" Text="VICTORY_FENCE_SLEEP: the game's end-of-frame wait blocks instead of keeping a CPU core busy. Its one game run on this base showed a white picture (not yet bisected): leave it off."/></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding Profile.FenceSleep}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Series S title pools"/><TextBlock Style="{StaticResource Hint}" Text="VICTORY_TITLE_POOL: Series S above 768 lines (DLAA draws 1080) runs the game out of two start-up pools; twice their size lets it start."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding TitlePoolChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Profile.TitlePool}" Width="320" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="{Binding DevMode, Converter={StaticResource Vis}}">
              <StackPanel>
                <TextBlock Text="Performance (empty: victory play's value)" Style="{StaticResource H2}"/>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Pipeline wait (ms)"/><TextBlock Style="{StaticResource Hint}" Text="How long a frame waits for a new shader before drawing without it (VICTORY_PIPELINE_WAIT_MS)."/></StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Profile.PipelineWaitMs, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="140" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Memory-compare threads (1-16)"/><TextBlock Style="{StaticResource Hint}" Text="Threads for the big memory compares (VICTORY_WIDE_THREADS)."/></StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Profile.WideThreads, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="140" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="VRAM kept for render targets (MB)"/><TextBlock Style="{StaticResource Hint}" Text="0-8192 (VICTORY_CARD_ROOM_FOR_TARGETS_MB)."/></StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Profile.TargetRoomMb, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="140" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
                <CheckBox IsThreeState="True" IsChecked="{Binding Profile.PipelineBook}" Content="Record pipelines for the warm-up (half: victory play's choice, on)"/>
                <CheckBox IsChecked="{Binding Profile.D3D12BackgroundOff}" Content="Stop the driver's background shader recompiles (experiment; off by default)"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="{Binding DevMode, Converter={StaticResource Vis}}">
              <StackPanel>
                <TextBlock Text="Diagnostics" Style="{StaticResource H2}"/>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="GPU crash data (DRED)"/><TextBlock Style="{StaticResource Hint}" Text="Light: which list a removed device stopped in. Costs GPU time (2-4x on RTX 20 when full). Diag build only."/></StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding DredModes}" SelectedItem="{Binding Profile.Dred}" Width="260" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Log filter"/><TextBlock Style="{StaticResource Hint}" Text="info, warn, or per part: victory_gpu=debug,info (debug needs diag)."/></StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Profile.LogFilter, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                </Grid>
                <CheckBox IsChecked="{Binding Profile.Panel}" Content="Show the in-game numbers panel from the start (F3 toggles it; costs a little)"/>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Pipeline cache limit"/><TextBlock Style="{StaticResource Hint}" Text="'Build pipeline cache' builds at most this many (0: all)."/></StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding Profile.WarmLimit, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Visibility="{Binding DevMode, Converter={StaticResource Vis}}">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock Text="Effective settings" Style="{StaticResource H2}" Margin="0"/>
                  <Button Content="Show effective settings" Command="{Binding Preview}" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="420"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== DIAGNOSTICS ============================== -->
      <TabItem>
        <DockPanel Margin="32,8,32,32">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="Diagnostics" Style="{StaticResource H1}"/>
              <TextBlock Text="{Binding ChecksSummary}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource Primary}" Content="Check again" Command="{Binding RunChecks}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="22,9"/>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Checks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="16,12">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Border Width="26" Height="26" CornerRadius="13" Background="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}" Foreground="#0D1014" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Fix}" Style="{StaticResource Hint}" Foreground="{StaticResource Accent}" Visibility="{Binding Fix, Converter={StaticResource Vis}}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ============================== LOGS ============================== -->
      <TabItem>
        <DockPanel Margin="32,8,32,32">
          <TextBlock DockPanel.Dock="Top" Text="Logs" Style="{StaticResource H1}" Margin="0,0,0,14"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBox Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}" Width="280" ToolTip="Filter the lines" Margin="0,0,12,0"/>
            <CheckBox IsChecked="{Binding ErrorsOnly}" Content="Warnings and errors only" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <CheckBox IsChecked="{Binding AutoScroll}" Content="Follow" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <Button Content="Copy" Command="{Binding CopyLog}" Margin="0,0,8,0"/>
            <Button Content="Clear view" Command="{Binding ClearLog}" Margin="0,0,8,0"/>
            <Button Content="Open session log" Command="{Binding OpenSessionLog}" Margin="0,0,8,0"/>
            <Button Content="Open crashes.log" Command="{Binding OpenCrashLog}" Margin="0,0,8,0"/>
            <Button Content="Log folder" Command="{Binding OpenLogs}"/>
          </WrapPanel>
          <Border Background="{StaticResource InputBg}" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10">
            <ListBox x:Name="LogList" ItemsSource="{Binding LogView}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource Mono}" FontSize="12">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="2,1"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#1E2836"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" Foreground="{Binding Level, Converter={StaticResource LineBrush}}" FontFamily="{StaticResource Mono}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- ============================== SYSTEM ============================== -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,8,32,32">
            <TextBlock Text="System" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding SystemLive}" Foreground="{StaticResource Muted}" Margin="0,4,0,18"/>
            <UniformGrid Columns="2" Margin="0,0,-16,0">
              <Border Style="{StaticResource CardBorder}" Margin="0,0,16,16">
                <StackPanel>
                  <TextBlock Text="Processor" Style="{StaticResource H2}"/>
                  <TextBlock Text="{Binding Machine.CpuName}" FontSize="15"/>
                  <TextBlock Style="{StaticResource Hint}">
                    <Run Text="{Binding Machine.PhysicalCores, Mode=OneWay}"/> cores · <Run Text="{Binding Machine.LogicalProcessors, Mode=OneWay}"/> threads
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,16,16">
                <StackPanel>
                  <TextBlock Text="Memory" Style="{StaticResource H2}"/>
                  <TextBlock FontSize="15"><Run Text="{Binding Machine.TotalRam, Mode=OneWay, Converter={x:Static l:Bytes.GB}}"/> RAM</TextBlock>
                  <TextBlock Style="{StaticResource Hint}">
                    Commit limit (RAM + paging file) <Run Text="{Binding Machine.CommitLimit, Mode=OneWay, Converter={x:Static l:Bytes.GB}}"/>
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,16,16">
                <StackPanel>
                  <TextBlock Text="Windows" Style="{StaticResource H2}"/>
                  <TextBlock Text="{Binding Machine.Os}"/>
                  <TextBlock Style="{StaticResource Hint}">Power plan: <Run Text="{Binding Machine.PowerPlan, Mode=OneWay, TargetNullValue=unknown}"/></TextBlock>
                  <TextBlock Style="{StaticResource Hint}">Hardware GPU scheduling: <Run Text="{Binding Machine.HardwareScheduling, Mode=OneWay, Converter={x:Static l:Bytes.OnOff}}"/></TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="0,0,16,16">
                <StackPanel>
                  <TextBlock Text="Launcher" Style="{StaticResource H2}"/>
                  <TextBlock Text="{Binding RepoText}" TextWrapping="Wrap"/>
                  <TextBlock Style="{StaticResource Hint}" Text="Profiles in %APPDATA%\RunkisLauncher, session logs in %LOCALAPPDATA%\RunkisLauncher\logs."/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <TextBlock Text="Graphics adapters" Style="{StaticResource H2}" Margin="0,8,0,10"/>
            <ItemsControl ItemsSource="{Binding Gpus}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}"/>
                      <TextBlock Text="{Binding Live}" Margin="0,8,0,0" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- ============================== BENCHMARK ============================== -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,8,32,32" DataContext="{Binding Bench}">
            <DockPanel Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Primary}" Command="{Binding Start}" Padding="26,10"
                        Visibility="{Binding Running, Converter={StaticResource Vis}, ConverterParameter=not}">
                  <TextBlock Text="▶  Start benchmark" Foreground="White" FontWeight="SemiBold"/>
                </Button>
                <Button Style="{StaticResource Danger}" Command="{Binding Cancel}" Padding="26,10"
                        Visibility="{Binding Running, Converter={StaticResource Vis}}">
                  <TextBlock Text="■  Cancel" Foreground="White" FontWeight="SemiBold"/>
                </Button>
              </StackPanel>
              <TextBlock Text="Benchmark" Style="{StaticResource H1}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18">
              The project's own method: the same save, the same scripted input, a warm-up from the first picture, then a measured
              window read from the layer's per-frame log and its five-second lines. Each candidate runs in turn (A B A B), one game
              at a time, and is stopped the normal way. Four identical runs vary by about ±0.4 fps, so smaller differences are noise.
            </TextBlock>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="{Binding ProgressText, Converter={StaticResource Vis}}">
              <StackPanel>
                <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap"/>
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="1" Height="6" Margin="0,10,0,0"
                             Background="{StaticResource Line}" Foreground="{StaticResource Accent}" BorderThickness="0"/>
              </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="Candidates" Style="{StaticResource H2}"/>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                             Text="A preset (applied over your profile's game, folders and card), a saved profile, or either with raw layer switches on top. The first one is the baseline the others are compared with."/>
                  <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Label"/>
                  <TextBlock Text="Extra settings, one VICTORY_NAME=value a line (optional)" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                  <TextBox Text="{Binding ExtraText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64"
                           FontFamily="{StaticResource Mono}" FontSize="12" VerticalScrollBarVisibility="Auto"/>
                  <TextBlock Text="{Binding ExtraErrors}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,6,0,0"
                             Visibility="{Binding ExtraErrors, Converter={StaticResource Vis}}"/>
                  <Button Content="Add candidate" Command="{Binding Add}" HorizontalAlignment="Left" Margin="0,10,0,12"/>
                  <ItemsControl ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Content="Make first" Padding="10,4" FontSize="12" Margin="8,0,6,0" CommandParameter="{Binding}"
                                      Command="{Binding DataContext.MakeBaseline, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                              <Button Content="Remove" Padding="10,4" FontSize="12" CommandParameter="{Binding}"
                                      Command="{Binding DataContext.Remove, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            </StackPanel>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <Run Text="{Binding Kind, Mode=OneWay}"/> <Run Text="{Binding Source, Mode=OneWay}"/> <Run Text="{Binding ExtraText, Mode=OneWay}"/>
                              </TextBlock>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="Timing and input" Style="{StaticResource H2}"/>
                  <UniformGrid Columns="3" Margin="0,0,-10,0">
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="Warm-up (s)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                      <TextBox Text="{Binding WarmupText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="Measured (s)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                      <TextBox Text="{Binding MeasureText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="Repeats" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                      <TextBox Text="{Binding RepeatsText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </UniformGrid>
                  <TextBlock Text="{Binding PlanText}" Style="{StaticResource Hint}" Margin="0,6,0,14"/>
                  <DockPanel Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Content="Load…" Command="{Binding LoadKeys}" Padding="10,4" FontSize="12" Margin="0,0,6,0"/>
                      <Button Content="Save…" Command="{Binding SaveKeys}" Padding="10,4" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="Key script (VICTORY_KEYS, optional)" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                  </DockPanel>
                  <TextBox Text="{Binding KeysText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110"
                           FontFamily="{StaticResource Mono}" FontSize="12" VerticalScrollBarVisibility="Auto"
                           ToolTip="seconds:key (held 0.2 s) or from-to:key, on lines or comma-separated; # starts a comment. Keys: a letter, a digit, Enter, Esc, Tab, Back, Up, Down, Left, Right."/>
                  <TextBlock Style="{StaticResource Hint}" Text="seconds:key holds it 0.2 s; from-to:key holds it all that time. Keys: a letter, a digit, Enter, Esc, Tab, Back, Up, Down, Left, Right. # starts a comment."/>
                  <TextBlock Text="{Binding KeysCheck}" Foreground="{Binding KeysTone}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Export CSV…" Command="{Binding ExportCsv}" Margin="0,0,8,0"/>
                    <Button Content="Benchmarks folder" Command="{Binding OpenFolder}"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Results" Style="{StaticResource H2}" Margin="0"/>
                    <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </DockPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding Report, Converter={StaticResource Vis}}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="Candidate" Width="220" Style="{StaticResource Label}"/>
                      <ItemsControl ItemsSource="{Binding Report.Columns}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding}" Width="128" Style="{StaticResource Label}" TextWrapping="Wrap" Padding="0,0,8,0"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Report.Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                            <DockPanel>
                              <StackPanel Width="220">
                                <TextBlock Text="{Binding Candidate}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Runs}" Style="{StaticResource Hint}"/>
                              </StackPanel>
                              <ItemsControl ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <StackPanel Width="128">
                                      <TextBlock Text="{Binding Value}" FontWeight="SemiBold"/>
                                      <TextBlock Text="{Binding Diff}" FontSize="11.5" Foreground="{Binding Converter={StaticResource CellTone}}" TextWrapping="Wrap" Margin="0,2,8,0"/>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <TextBlock Text="Verdict" Style="{StaticResource H2}" Margin="0,12,0,6" Visibility="{Binding Report, Converter={StaticResource Vis}}"/>
                <ItemsControl ItemsSource="{Binding Report.Verdicts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Visibility="{Binding Report, Converter={StaticResource Vis}}"
                           Text="Mean ± spread (half the range) over the good runs. A difference is within noise under max(0.5 fps, 2 × the larger spread); the other figures use floors of 1 ms (median), 10 ms (worst), 1 hitch, 0.5 ms (preparing, GPU, copying back) and 64 MB. —: not measured."/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="{Binding Runs.Count, Converter={StaticResource Vis}}">
              <StackPanel>
                <TextBlock Text="Runs" Style="{StaticResource H2}"/>
                <ItemsControl ItemsSource="{Binding Runs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="Log" Padding="10,3" FontSize="12" VerticalAlignment="Top" CommandParameter="{Binding LogPath}"
                                  Command="{Binding DataContext.OpenRunLog, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                          <Border Width="3" CornerRadius="2" Background="{Binding Tone}" Margin="0,0,10,0"/>
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding Title, Mode=OneWay}"/> · <Run Text="{Binding Status, Mode=OneWay}" Foreground="{Binding Tone, Mode=OneWay}"/></TextBlock>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Foreground="{StaticResource Muted}"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Refresh}" Padding="10,4" FontSize="12"/>
                  <TextBlock Text="Past benchmarks" Style="{StaticResource H2}" Margin="0"/>
                </DockPanel>
                <TextBlock Text="None yet. Each benchmark is saved in %LOCALAPPDATA%\RunkisLauncher\benchmarks." Style="{StaticResource Hint}"
                           Visibility="{Binding Past.Count, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                <ListBox ItemsSource="{Binding Past}" SelectedItem="{Binding SelectedPast}" MaxHeight="300"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="10,7" Margin="0,0,0,2"><ContentPresenter/></Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/></Trigger>
                              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#1C2A45"/></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- ============================== CONTROLS ============================== -->
      <TabItem>
        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Controls}">
          <StackPanel Margin="32,8,32,32" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Controls" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18" TextWrapping="Wrap">
              The keyboard and mouse drive one stand-in controller, which the game sees together with any real pad (the
              game also reads the keyboard itself). Click a key to change it, then press a key or a mouse button (Esc
              cancels). Each button can have two keys. Save the profile on the Settings page (or below) to keep the change.
            </TextBlock>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Mouse" Style="{StaticResource H2}"/>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Mouse camera"/><TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="The mouse turns the camera (right stick). Its buttons are in the table: by default left fires (RT), right aims (LT), middle clicks the stick. The cursor is held at the window's centre while it has focus (Alt+Tab to leave). Upstream's own mouse did not turn the camera in a test, so this is on by default. VICTORY_MOUSE"/></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding Mouse}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Mouse sensitivity"/><TextBlock Style="{StaticResource Hint}" Text="0.1-10; 1 is the default. Higher turns faster."/></StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding MouseSense, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Invert up and down"/><TextBlock Style="{StaticResource Hint}" Text="Moving the mouse up looks down. VICTORY_MOUSE_INVERT_Y"/></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding InvertY}" VerticalAlignment="Center"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="The game's own mouse"/><TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Upstream's native mouse with the cursor held in the window (VICTORY_MOUSE_CAPTURE). In the user's test it did not turn the camera; with the mouse camera on, it is not fed."/></StackPanel>
                  <CheckBox Grid.Column="1" IsChecked="{Binding Capture}" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Reset to defaults" Command="{Binding Reset}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Primary}" Content="Save profile" Command="{Binding DataContext.Save, RelativeSource={RelativeSource AncestorType=Window}}" Padding="18,7"/>
                  </StackPanel>
                  <TextBlock Text="Key bindings" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/><ColumnDefinition Width="200"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="XBOX" Style="{StaticResource Label}"/>
                  <TextBlock Grid.Column="1" Text="PS5 (DUALSENSE)" Style="{StaticResource Label}"/>
                  <TextBlock Grid.Column="2" Text="KEY" Style="{StaticResource Label}"/>
                  <TextBlock Grid.Column="3" Text="SECOND KEY" Style="{StaticResource Label}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,5">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/><ColumnDefinition Width="200"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Xbox}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding Ps5}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                          <Button Grid.Column="2" Content="{Binding Key1}" Command="{Binding Bind1}" Margin="0,0,8,0" Padding="10,5" HorizontalContentAlignment="Center"/>
                          <Button Grid.Column="3" Content="{Binding Key2}" Command="{Binding Bind2}" Margin="0,0,8,0" Padding="10,5" HorizontalContentAlignment="Center"/>
                          <Button Grid.Column="4" Content="✕" Command="{Binding Clear}" ToolTip="No key for this button" Padding="10,5"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding Issues}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding Issues, Converter={StaticResource Vis}}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
